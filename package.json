{
  "name": "better-drip-writer",
  "displayName": "Better Dripwriter",
  "version": "3.2.9",
  "description": "Types text into supported web editors with adjustable speed, corrections, and pauses.",
  "author": "Alexey Fedorov",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "plasmo dev",
    "dev:firefox": "plasmo dev --target=firefox-mv3",
    "build": "plasmo build && node scripts/fix-content-manifest.mjs chrome-mv3-prod && node scripts/sync-unpacked.mjs",
    "build:firefox": "plasmo build --target=firefox-mv3 && node scripts/fix-content-manifest.mjs firefox-mv3-prod",
    "package": "pnpm build && pnpm build:firefox && plasmo package && plasmo package --target=firefox-mv3",
    "typecheck": "tsc --noEmit",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test": "node --test \"tests/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/*.test.mjs\"",
    "test:all": "pnpm test && pnpm test:integration"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "^6.0.3"
  },
  "manifest": {
    "name": "Better Dripwriter",
    "permissions": [
      "storage",
      "scripting"
    ],
    "host_permissions": [
      "<all_urls>"
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "better-drip-writer@local.extension",
        "data_collection_permissions": {
          "required": [
            "none"
          ]
        }
      }
    }
  }
}
